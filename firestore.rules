rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // OJO: isSignedIn() solo significa "ha iniciado sesion de Google", algo
    // que cualquiera puede hacer sin conocer el codigo de invitacion (la
    // config de Firebase es publica por diseño). isPlayer() es la que
    // realmente identifica a alguien del grupo: exige ademas tener ya un
    // documento en players/, que solo se crea validando el codigo correcto.
    function isPlayer() {
      return isSignedIn() && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }

    // Sin Cloud Functions (plan gratuito), el rol de admin se valida aqui:
    // el propio documento players/{uid} guarda isAdmin, fijado una unica vez
    // en su creacion segun que codigo se aporte (ver reglas de /players).
    function isAdmin() {
      return isPlayer()
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true;
    }

    // Codigos de invitacion. No se leen nunca directamente desde el cliente,
    // solo se consultan internamente via get() desde otras reglas.
    match /config/{docId} {
      allow read, write: if false;
    }

    match /players/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isPlayer();

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'isAdmin', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (
          (request.resource.data.code == get(/databases/$(database)/documents/config/app).data.playerCode
            && request.resource.data.isAdmin == false)
          ||
          (request.resource.data.code == get(/databases/$(database)/documents/config/app).data.adminCode
            && request.resource.data.isAdmin == true)
        );

      allow update, delete: if false;
    }

    match /matches/{matchId} {
      // Los partidos (equipos, jornada, hora) no son secretos entre el grupo;
      // solo el marcador se rellena mas tarde y viaja dentro del mismo
      // documento. Pero si hace falta haber entrado con el codigo (isPlayer),
      // para no dar ni siquiera esto a cualquiera que solo haya iniciado
      // sesion de Google sin conocer el codigo.
      allow read: if isPlayer();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Cualquier jugador puede apuntarse a si mismo en predictedUids al
        // pronosticar (solo añadir su propio uid, nunca quitar a otros ni
        // añadir a nadie mas), para poder mostrar "quien falta" sin revelar
        // marcadores de nadie antes del kickoff.
        isPlayer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['predictedUids'])
        && request.resource.data.predictedUids.hasAll(
          ('predictedUids' in resource.data) ? resource.data.predictedUids : []
        )
        && request.resource.data.predictedUids.hasAny([request.auth.uid])
        && request.resource.data.predictedUids.size()
          <= (('predictedUids' in resource.data) ? resource.data.predictedUids.size() : 0) + 1
      );
    }

    match /predictions/{predictionId} {
      // Cada uno ve siempre el suyo. El de los demas solo es visible cuando
      // ya ha pasado el kickoff (denormalizado en el propio pronostico para
      // poder consultarlo de forma segura, ver nota en create). Admin ve todo.
      allow get, list: if isPlayer() && (
        resource.data.uid == request.auth.uid ||
        resource.data.kickoff <= request.time ||
        isAdmin()
      );

      allow create: if isPlayer()
        && (
          (
            // El propio jugador crea su pronostico antes del kickoff (flujo normal).
            predictionId == (request.resource.data.matchId + '_' + request.auth.uid)
            && request.resource.data.uid == request.auth.uid
            && request.time < request.resource.data.kickoff
          ) ||
          (
            // El admin puede introducir el pronostico de cualquiera en cualquier
            // momento, para volcar jornadas ya jugadas antes de tener la app.
            isAdmin()
            && predictionId == (request.resource.data.matchId + '_' + request.resource.data.uid)
          )
        )
        && request.resource.data.keys().hasOnly(
          ['matchId', 'uid', 'playerName', 'jornada', 'homeGoals', 'awayGoals', 'kickoff', 'points', 'createdAt']
        )
        && request.resource.data.homeGoals is int && request.resource.data.homeGoals >= 0
        && request.resource.data.awayGoals is int && request.resource.data.awayGoals >= 0
        && request.resource.data.points == null
        // El kickoff que se guarda en el pronostico tiene que coincidir con el
        // del partido real, para que la regla de lectura de arriba sea fiable.
        && request.resource.data.kickoff == get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.kickoff;

      allow update: if isPlayer() && (
        (
          // El jugador puede corregir su pronostico mientras no haya empezado el partido.
          resource.data.uid == request.auth.uid
          && request.time < resource.data.kickoff
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeGoals', 'awayGoals'])
          && request.resource.data.homeGoals is int && request.resource.data.homeGoals >= 0
          && request.resource.data.awayGoals is int && request.resource.data.awayGoals >= 0
        ) ||
        (
          // El admin puede tocar los puntos (calculados al cerrar el partido).
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
        ) ||
        (
          // El admin puede corregir el marcador pronosticado de cualquiera en
          // cualquier momento (mismo caso de volcado/correccion manual).
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeGoals', 'awayGoals'])
          && request.resource.data.homeGoals is int && request.resource.data.homeGoals >= 0
          && request.resource.data.awayGoals is int && request.resource.data.awayGoals >= 0
        )
      );

      allow delete: if isAdmin();
    }

    match /poolContributions/{id} {
      // Aportaciones al bote (porra/fantasy), introducidas a mano por el
      // admin: quien, cuanto y en que jornada. Visible para todo el grupo,
      // solo el admin puede añadir o corregir (borrando y repitiendo).
      allow read: if isPlayer();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['game', 'jornada', 'uid', 'playerName', 'amount', 'createdAt'])
        && request.resource.data.game in ['porra', 'fantasy']
        && request.resource.data.jornada is int && request.resource.data.jornada > 0
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
